# =============================================================================
# LabelFlow 部署环境变量（复制为 .env 后修改）
#
# 用法：
#   cp .env.example .env
#   ./deploy/init.sh            # 生成密钥、检查环境、起服务
#
# 安全要求（不满足时 deploy/preflight.sh 会拦）：
#   · NODE_ENV=production 时 JWT_SECRET ≥ 32 字符且不是示例值
#   · DB_PASS ≥ 16 字符，且不是 labelflow
#   · 不要把 .env 提交进版本库（.gitignore 已排除）
# =============================================================================

# ---------- 运行模式 ----------
# production：开启强校验（弱密钥/弱口令会拒绝启动）
# development：允许弱配置，仅本地/演示
NODE_ENV=production

# ---------- 后端安全 ----------
# 生成：openssl rand -base64 48  （deploy/init.sh 会自动生成）
JWT_SECRET=REPLACE_WITH_48_CHARS_RANDOM_STRING_FROM_openssl_rand_base64_48

# ---------- 数据库 ----------
DB_NAME=labelflow
DB_USER=labelflow
# 生成：openssl rand -base64 24 | tr -d '/+=' | head -c 24
DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD_16+

# ---------- 端口（宿主） ----------
# 客户现场若端口冲突，改这里即可，容器内部端口不变
PORT_API=3200
PORT_CONSOLE=5173
PORT_PLATFORM=5181
PORT_PDA=5185

# ---------- 数据初始化 ----------
# 1 = 首次部署灌演示数据（培训/演示用）；正式上线请设 0，客户数据用迁移工具导入
SEED_DEMO=1

# ---------- 业务配置 ----------
# GS1 厂商前缀（箱码 SSCC 用，7 位公司前缀）
GS1_COMPANY_PREFIX=6901234
# SSCC 扩展位（0-9）
SSCC_EXTENSION_DIGIT=0

# ---------- 打印 ----------
# 内部打印服务的 service token（容器间调用 /print/jobs 用）
WMS_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
