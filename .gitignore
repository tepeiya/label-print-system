# 依赖
node_modules/
.pnp
.pnp.js
# pnpm 的包缓存（内容寻址 store，node_modules 由它硬链接而来）。
# 本机曾把 store 指到仓库目录内，导致 232MB 缓存被 git add -A 一起提交（见 95b4970）。
.pnpm-store/
# console / platform 用 pnpm（各自目录下有 pnpm-lock.yaml），backend 与 mcp-server 用 npm（lock 已入库）。
# 在 console / platform 里误用 npm 会生成 package-lock.json，留着只有两种坏结果：
# 被提交进去（双锁文件漂移）或被误删本地缓存，所以一律不入库。
apps/console/package-lock.json
apps/platform/package-lock.json

# 构建产物
dist/
build/
out/
*.tsbuildinfo

# 环境变量与密钥
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.swp

# 测试/覆盖率产物（保留源码，忽略生成物）
coverage/

# OCR 语言包（约 30MB，按 docs/09-ai-template-generation.md §9.13.4 下载到本地）
backend/assets/tessdata/*.traineddata
backend/assets/tessdata/*.traineddata.gz
backend/*.traineddata
dump.rdb
