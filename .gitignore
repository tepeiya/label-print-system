dist/
build/
out/
*.tsbuildinfo

# 环境变量与密钥
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.swp

