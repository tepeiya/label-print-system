# ========================================
# LabelFlow 后端配置示例
# 用法：cp .env.example .env，按实际环境修改
# ========================================

# ---- 服务 ----
# 默认端口 3200（交接文档约定；Docker 映射 3000）
PORT=3200

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5433
DB_USER=labelflow
DB_PASS=labelflow
DB_NAME=labelflow

# 或直接用连接串（Docker Compose 场景）
# DB_URL=postgresql://labelflow:labelflow@postgres:5432/labelflow

# ---- Redis（队列）----
# 分项配置
REDIS_HOST=localhost
REDIS_PORT=6380
# 或完整 URL（优先）
REDIS_URL=redis://localhost:6380

# ---- JWT 安全 ----
# **生产必须改掉！** 48 字节以上随机字符串（建议 64 字符 hex）
JWT_SECRET=change-me-in-production-please-use-64-hex-chars-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- SQL 数据源加密 ----
# AES-256-GCM 用 32 字节 hex key（64 字符）。不配会用内置 dev key 并打 WARN
SQL_SECRET_KEY=3a9f1b2c4d5e6f7890abcdef1234567890abcdef1234567890abcdef123456789

# ---- AI / LLM ----
# 任一 AI_* 或 OPENAI_* 组均可，留空则 AI 模块只跑规则引擎
# AI_VISION_API_KEY=sk-xxx
# AI_VISION_BASE_URL=https://api.deepseek.com/v1
# AI_VISION_MODEL=deepseek-chat
# 或兼容命名
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ---- OCR ----
# OCR_ENDPOINT=http://localhost:8090  # PaddleOCR HTTP 服务（可选）
# OCR_LANG=eng+chi_sim
