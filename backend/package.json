    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/bullmq": "^10.0.0",
    "@bwip-js/node": "^4.0.0",
    "pdf-lib": "^1.17.0",
    "bullmq": "^5.0.0",
    "pg": "^8.11.0",
    "typeorm": "^0.3.20",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
